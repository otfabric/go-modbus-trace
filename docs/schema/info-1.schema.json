        "tcp": {
          "type": "integer"
        },
        "tls": {
          "type": "integer"
        }
      },
      "required": [
        "modbus_tcp",
        "tcp",
        "tls"
      ],
      "type": "object"
    },
    "mbtracectl.infoDoc": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "type": "integer"
        },
        "traces": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/mbtracectl.infoJSON"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "schema_version",
        "traces"
      ],
      "type": "object"
    },
    "mbtracectl.infoJSON": {
      "additionalProperties": false,
      "properties": {
        "flows": {
          "$ref": "#/$defs/mbtracectl.flowCounts"
        },
