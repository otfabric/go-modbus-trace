{
  "$defs": {
    "buildinfo.Info": {
      "additionalProperties": false,
      "properties": {
        "built": {
          "type": "string"
        },
        "commit": {
          "type": "string"
        },
        "go": {
          "type": "string"
        },
        "libraries": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/buildinfo.Library"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ]
        },
        "name": {
          "type": "string"
        },
        "platform": {
          "type": "string"
        },
